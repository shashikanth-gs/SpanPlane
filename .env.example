# Leave unset for the full local-first Workbench experience.
# Set both variables to deploy the constrained public demo.
# A2A_DEPLOYMENT_MODE=demo
# NEXT_PUBLIC_A2A_DEMO_MODE=true

# Never set this to true on a public deployment. It is only for a trusted
# local development environment that needs to reach a private test agent.
# A2A_ALLOW_PRIVATE_NETWORKS=false

# Content-aware raw evidence views are enabled for local use by default.
# Disable them when normalized raw payloads should not be visible in the UI.
# A2A_ENABLE_RAW_VIEWS=false

# Adds a separate Experimental view for structured application/json data
# parts. Existing rendered, structured, and raw views remain unchanged.
# A2A_ENABLE_RICH_JSON=true

# Built-in sideband adapters recognize the provisional Workbench contract and
# a2a-wrapper's urn:x-a2a:trace:v1. Add deployment-specific URIs as a
# comma-separated list; built-in compatibility URIs remain enabled.
# A2A_SIDEBAND_EXTENSION_URIS=https://example.com/extensions/sideband/v1

# The npx command starts a pinned, managed Phoenix runtime by default. Use
# `--telemetry off` or this variable to run only A2A and sideband evidence.
# A2A_TELEMETRY_MODE=off
# A2A_PYTHON=/absolute/path/to/python3
# A2A_DATA_DIR=/absolute/path/to/local-data

# Point at an existing Phoenix deployment instead of starting a subprocess.
# No Phoenix project name is imposed; correlation uses A2A and OTEL attributes.
# A2A_PHOENIX_BASE_URL=http://127.0.0.1:6006
# A2A_OTLP_HTTP_ENDPOINT=http://127.0.0.1:6006/v1/traces
# A2A_OTLP_GRPC_ENDPOINT=http://127.0.0.1:4317
